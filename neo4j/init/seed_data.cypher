// --- Project Nodes and Relationships ---
MERGE (p1:Project {name: 'AD user info', description: 'The application extracts records of active and inactive users in AD domain and output to spreadsheet file.', tagline: 'It is an application to extract records of active and inactive users in AD domain.', developed_on: '2024'});
MATCH (p:Project {name: 'AD user info'}), (d:Domain {name: 'Utility'}) MERGE (p)-[:BELONGS_TO]->(d);
MATCH (p:Project {name: 'AD user info'}), (l:Location {name: 'Database'}) MERGE (p)-[:LOCATED_IN]->(l);
MATCH (p:Project {name: 'AD user info'}), (l:Location {name: 'CB'}) MERGE (p)-[:LOCATED_IN]->(l);
MATCH (p:Project {name: 'AD user info'}), (l:Location {name: 'Chennai'}) MERGE (p)-[:LOCATED_IN]->(l);
MATCH (p:Project {name: 'AD user info'}), (t:Technology {name: 'Python'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (p:Project {name: 'AD user info'}), (t:Technology {name: 'CLI'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (dev:Developer {name: 'Roshan Koshy'}), (p:Project {name: 'AD user info'}) MERGE (dev)-[:DEVELOPED]->(p);

MERGE (p2:Project {name: 'AcidEx', description: 'This software was developed in collaboration with WSS, Ahmedabad, to tackle challenges in acid job design for various fields of ONGC. Software takes reservoir parameters and automatically generates an appropriate acid job design for the given reservoir.', tagline: 'It is an application to design acid job for Well Stimulation Services (WSS).', developed_on: '2024'});
MATCH (p:Project {name: 'AcidEx'}), (d:Domain {name: 'Reservoir'}) MERGE (p)-[:BELONGS_TO]->(d);
MATCH (p:Project {name: 'AcidEx'}), (l:Location {name: 'IRS'}) MERGE (p)-[:LOCATED_IN]->(l);
MATCH (p:Project {name: 'AcidEx'}), (l:Location {name: 'Ahmedabad'}) MERGE (p)-[:LOCATED_IN]->(l);
MATCH (p:Project {name: 'AcidEx'}), (t:Technology {name: 'VB.net'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (p:Project {name: 'AcidEx'}), (t:Technology {name: 'Desktop based application'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (dev:Developer {name: 'Arpit Buddhiwant'}), (p:Project {name: 'AcidEx'}) MERGE (dev)-[:DEVELOPED]->(p);
MATCH (dev:Developer {name: 'Sohil Shah'}), (p:Project {name: 'AcidEx'}) MERGE (dev)-[:DEVELOPED]->(p);
MATCH (dev:Developer {name: 'Sneha Gurumukhi'}), (p:Project {name: 'AcidEx'}) MERGE (dev)-[:DEVELOPED]->(p);

MERGE (p3:Project {name: 'Annual Work Program', description: 'The portal for Annual Work Program allows users from various basins and institutes to enter their projects under AWP. Project owners can update their progress through milestones and deliverables. These projects are monitored by E&D Dte through dashboards The distinctive features of this portal include data entry in standard format with provision for attachments, generation of reports in various formats as per requirement, automated status reporting through periodic mails, project progress monitoring through Gantt charts and a dedicated dashboard to provide overview of all projects. This application is currently available for interpretation projects and IDT.', tagline: 'Web-based portal for digitalization of Annual Work Program process thus achieving improved workflow and integration. This portal standardizes data entry process and automates reporting and monitoring of projects.', developed_on: '2024'});
MATCH (p:Project {name: 'Annual Work Program'}), (d:Domain {name: 'Project Management & Process Workflow'}) MERGE (p)-[:BELONGS_TO]->(d);
MATCH (p:Project {name: 'Annual Work Program'}), (l:Location {name: 'Expl. Data Services (formerly EPINET)'}) MERGE (p)-[:LOCATED_IN]->(l);
MATCH (p:Project {name: 'Annual Work Program'}), (t:Technology {name: 'NodeJS'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (p:Project {name: 'Annual Work Program'}), (t:Technology {name: 'Bootstrap'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (p:Project {name: 'Annual Work Program'}), (t:Technology {name: 'Oracle'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (p:Project {name: 'Annual Work Program'}), (t:Technology {name: 'Web based application'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (dev:Developer {name: 'Jim Moses'}), (p:Project {name: 'Annual Work Program'}) MERGE (dev)-[:DEVELOPED]->(p);
MATCH (dev:Developer {name: 'Somya Sangal'}), (p:Project {name: 'Annual Work Program'}) MERGE (dev)-[:DEVELOPED]->(p);

MERGE (p4:Project {name: 'Award Nomination Portal', description: 'Web-based portal for nomination for the awards like safety champion, safe installation, excellenece award etc. Quarterly the employees can nominate themselves for the awards. The candidate describe all the details like financial impact along with project photo if any.Then the nomination request will go the CO, Sectional Head for their remarks.According to the type of award Head HSE and Head HR can present the case in VCC with their logins in the portal itself.According to the VCC decision the same will be updated in the portal and final list of the participants is generated in the portal for the particular quarter. It smoothen the process from collecting the nomation to the final appoved list of the awardee though transparent process.', tagline: 'Web-based portal for nomination for the awards like safety champion, safe installation, excellenece award etc.', developed_on: '2024'});
