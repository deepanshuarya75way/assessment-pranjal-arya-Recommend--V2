MATCH (p:Project {name: 'LAS Viewer'}), (t:Technology {name: 'Web based application'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (dev:Developer {name: 'A.V. Satyanarayana'}), (p:Project {name: 'LAS Viewer'}) MERGE (dev)-[:DEVELOPED]->(p);

MERGE (p38:Project {name: 'LDI (Landmark Data Import)', description: 'Landmark Data Import (LDI) was a set of plugins to transfer seismic project data over a network from Openworks into Petrel. It was upgraded and maintained for three subsequent releases of the OpenWorks and Petrel software over a period from 2014 to 2017 after which the upgrades could not be carried on due to dismantling of the development team. The term “Landmark” refers to the then title of the Interpretaion Software based on OpenWorks provided by Hallibutron which over the years was replaced by DSD and then DSG. The software comprises of an OpenWorks plugin and a Petrel plugin that communicate together over network to achieve the project data transfer. The following data could be imported: CRS Boreholes (Well Header,TD Curves, Deviation data and Logs) Stratigraphic Columns(Picks and Markers) Fault Planes 2D Seimsic lines and 2D horizons 3D Seismic Volumes and Horizons', tagline: 'Landmark Data Import (LDI) enables users to transfer seismic project data from Openworks Interpretation Software (Landmark) into Petrel over a network without a need of explicit data export and import.', developed_on: '2014'});
MATCH (p:Project {name: 'LDI (Landmark Data Import)'}), (d:Domain {name: 'Data Management'}) MERGE (p)-[:BELONGS_TO]->(d);
MATCH (p:Project {name: 'LDI (Landmark Data Import)'}), (l:Location {name: 'GEOPIC'}) MERGE (p)-[:LOCATED_IN]->(l);
MATCH (p:Project {name: 'LDI (Landmark Data Import)'}), (l:Location {name: 'Dehradun'}) MERGE (p)-[:LOCATED_IN]->(l);
MATCH (p:Project {name: 'LDI (Landmark Data Import)'}), (t:Technology {name: 'C# with Ocean SDK for Petrel'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (p:Project {name: 'LDI (Landmark Data Import)'}), (t:Technology {name: 'C/C++ with OpenWorks SD'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (p:Project {name: 'LDI (Landmark Data Import)'}), (t:Technology {name: 'Desktop based application'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (dev:Developer {name: 'Polash Ranjan Bora'}), (p:Project {name: 'LDI (Landmark Data Import)'}) MERGE (dev)-[:DEVELOPED]->(p);
MATCH (dev:Developer {name: 'Vivek Gaurav Saini'}), (p:Project {name: 'LDI (Landmark Data Import)'}) MERGE (dev)-[:DEVELOPED]->(p);
MATCH (dev:Developer {name: 'Nikhil Pratap Singh'}), (p:Project {name: 'LDI (Landmark Data Import)'}) MERGE (dev)-[:DEVELOPED]->(p);

MERGE (p39:Project {name: 'Laboratory Analysis Report(LAR)', description: 'Laboratory Analysis Report (LAR) is a comprehensive report containing various data types from both Geological and Geological laboratories. Additionally it also has well log data and object perforation information. The various data classes included in LAR are Well Header, Well Stratigraphy, Well Log, Lithology, Objects, Core, Petrophysical Studies, Formation Water, Sedimentology, Paleontology/Palynology/Biostratigraphy, Paleo Environment, Source Rock, Oil Analysis and Gas Analysis This application is available within Data Viewer web portal.', tagline: 'Laboratory Analysis Report is a comprehensive report containing various data types from both Geological and Geological laboratories. Additionally it also has well log data and object perforation information.', developed_on: '2024'});
