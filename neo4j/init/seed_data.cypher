MATCH (p:Project {name: 'Seismic EBCDIC Header Generation Utility'}), (t:Technology {name: 'Desktop/Web based application'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (dev:Developer {name: 'Sanjay Chakravorty'}), (p:Project {name: 'Seismic EBCDIC Header Generation Utility'}) MERGE (dev)-[:DEVELOPED]->(p);

MERGE (p71:Project {name: 'Single Point CRS Conversion Mobile app', description: 'Single point CRS conversion mobile app is an Android based mobile application that provides functionality of datum and/or projection conversion for location data. Users can convert location data (latitude and longitude) from one datum/spheroid to another datum/spheroid (e.g. WGS-72 to WGS-84). User can also convert location data from latitude/longitude to northing/easting (X/Y) and vice versa. Conversion for all the prominent spheroids used in ONGC are available in the application. Transformation details including tranformation method, projection parametrs etc. are available for application user\'s reference. Users can also get the distance and bearing between any two points.', tagline: 'Android based Coordinate Reference System (CRS), data transformation mobile app including distance bearing calculation.', developed_on: '2024'});
