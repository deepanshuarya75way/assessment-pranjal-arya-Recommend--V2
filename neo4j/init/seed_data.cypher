MERGE (p21:Project {name: 'Exploration & Procduction Unit Converter and Calculator Mobile App.', description: 'Exploration and Production Unit Converter (EPUC) is an Android based mobile app developed keeping in mind the requirement of conversion of units between various unit system of oil & gas industry in general and ONGC in particular. It has provisions for unit conversion from metric to field units and vice versa. Some of the examples of the unit conversions are from Cubic Meters to Barrels, Litres/Minute to Gallons/Minute, Metric Ton to Pound, Bar to PSI etc. These are sub divided under various sections like Length, Weight, Density, Volume, Pump Discharge, Pipe Volume, Gradient, Temperature, Pressure and Flow rate unit conversions. In addition to the above sections there is one section named “Calculation” which deals with various calculations used in field operations. Examples are calculation of Hydrostatic Pressure, Buoyancy Factor, Annular capacity between casing or hole and drill pipe, tubing or casing; MWE from LOT data etc.', tagline: 'Android based mobile app for conversion of units, those are used in ONGC . It can also calculate Hydrostatic pressue, Buoyancy Factor etc.', developed_on: '2024'});
MATCH (p:Project {name: 'Exploration & Procduction Unit Converter and Calculator Mobile App.'}), (d:Domain {name: 'Mobile Application'}) MERGE (p)-[:BELONGS_TO]->(d);
MATCH (p:Project {name: 'Exploration & Procduction Unit Converter and Calculator Mobile App.'}), (l:Location {name: 'Expl. Data Services (formerly EPINET)'}) MERGE (p)-[:LOCATED_IN]->(l);
MATCH (p:Project {name: 'Exploration & Procduction Unit Converter and Calculator Mobile App.'}), (t:Technology {name: 'Java'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (p:Project {name: 'Exploration & Procduction Unit Converter and Calculator Mobile App.'}), (t:Technology {name: 'Mobile based application'}) MERGE (p)-[:USES_TECH]->(t);
MATCH (dev:Developer {name: 'Sanjay Chakravorty'}), (p:Project {name: 'Exploration & Procduction Unit Converter and Calculator Mobile App.'}) MERGE (dev)-[:DEVELOPED]->(p);

